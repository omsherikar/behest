# Copy to .env and fill in. .env is gitignored; never commit real keys.

# PayPal sandbox REST app, from developer.paypal.com > Apps & Credentials.
# The app needs Save payment methods, PayPal and Venmo saving, and Transaction search enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The id of the app's sandbox webhook, from the same page. While it is unset, every webhook
# fails verification and is ignored.
PAYPAL_WEBHOOK_ID=

# A second US sandbox business account: the demo seller who receives payouts.
PAYEE_EMAIL=

# Signs the demo session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=
# Ed25519 key that signs mandates and receipts, and its key id. Generate both with: npm run keys
RECEIPT_SIGNING_KEY=
RECEIPT_KEY_ID=
# Lets the operator reset the demo by sending it in the x-demo-reset-key header; unset or under 16 characters turns the reset off. Generate one with: openssl rand -base64 24
DEMO_RESET_KEY=
# The app's public origin, used in PayPal return links: scheme, host and port only, no path.
APP_URL=http://localhost:3000
# Rate limits key on the X-Forwarded-For entry this many proxies from the right (default 1): 1 behind one reverse proxy such as Caddy.
TRUSTED_PROXY_HOPS=1
# Set to 1 only when Cloudflare is in front, so rate limits key on its cf-connecting-ip header; a client could forge it otherwise.
TRUST_CLOUDFLARE_HEADERS=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Claude, for every model call. Without it the dashboard analyst is hidden.
ANTHROPIC_API_KEY=
# Daily ceiling on Claude spend in US dollars (default 5); model calls stop for the day once it is reached.
LLM_DAILY_CAP_USD=

# Development only: set to 1 to replay recorded Claude replies instead of calling Claude.
LLM_STUB=

# Channel3 product search, for open-web market prices: the shopping agent's search and listing benchmarks.
CHANNEL3_API_KEY=

# Production only: the Postgres connection string. Locally, leave it unset to use PGlite under .data/.
DATABASE_URL=
