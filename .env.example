# Copy to .env and fill in. .env is gitignored; never commit real keys.

# PayPal sandbox REST app, from developer.paypal.com > Apps & Credentials.
# The app needs Save payment methods, PayPal and Venmo saving, and Transaction search enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# A second US sandbox business account: the demo seller who receives payouts.
PAYEE_EMAIL=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Optional: the AG Studio AI assistant on /dashboard. If blank, an OPENAI_API_KEY already in
# your environment is used instead; with neither, the assistant is hidden.
AG_STUDIO_OPENAI_API_KEY=

# Comma-separated OpenAI model ids for the assistant's model picker; the first is the default.
OPENAI_MODELS=
