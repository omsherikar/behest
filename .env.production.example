# Settings for a deployment with docker-compose.yml. On the server, copy this to .env.production,
# fill it in, and link .env to it (docs/deploy.md). The filled copy holds secrets: keep it on the
# server only and never commit it.

# --- Hosting ---
# The domain Caddy serves and gets an HTTPS certificate for. Its DNS A record must point at the server.
DOMAIN=behest.example.com
# The app's public origin, https://<DOMAIN> with no path: PayPal return links and the webhook URL are built from it.
APP_URL=https://behest.example.com
# Password for the bundled Postgres; docker-compose.yml builds DATABASE_URL from it. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Rate limits key on the X-Forwarded-For entry this many proxies from the right: 1 for Caddy alone.
TRUSTED_PROXY_HOPS=1
# Set to 1 only when Cloudflare proxies every request, so rate limits key on its cf-connecting-ip header; a client could forge it otherwise.
TRUST_CLOUDFLARE_HEADERS=
# The records the guided demo on the home page opens, by id, as JSON:
# {"allowed":"<purchase id>","held":"<purchase id>","blocked":"<purchase id>","order":"<seller order id>","dispute":"<dispute id>"}
# Set it after the one real run (docs/deploy.md, step 8), and again after a demo reset, which removes those records.
# A missing or stale id leaves that step of the tour without its highlight; nothing breaks.
TOUR_PINS=

# --- PayPal sandbox ---
# The sandbox REST app's credentials, from developer.paypal.com > Apps & Credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id `npm run webhook:register` prints for this deployment. Until it is set, every webhook fails verification and is ignored.
PAYPAL_WEBHOOK_ID=
# A second US sandbox business account: the demo seller who receives payouts.
PAYEE_EMAIL=

# --- Signing and sessions ---
# The Ed25519 key that signs mandates and receipts, and its key id: the two lines `npm run keys` prints.
RECEIPT_SIGNING_KEY=
RECEIPT_KEY_ID=
# Signs the demo session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=
# Lets the operator reset and seed the demo with this in the x-demo-reset-key header; unset or under 16 characters turns the reset off. Generate one with: openssl rand -hex 24
DEMO_RESET_KEY=

# --- Claude ---
# For every model call. Without it the dashboard analyst is hidden.
ANTHROPIC_API_KEY=
# The most model calls may cost per UTC day, in US dollars (default 5).
LLM_DAILY_CAP_USD=5
# The most the dashboard analyst and the catalog builder, which any visitor can start, may each cost per
# UTC day, in US dollars (default 1 each). Their spend also counts toward LLM_DAILY_CAP_USD.
LLM_ANALYST_DAILY_CAP_USD=1
LLM_CATALOG_DAILY_CAP_USD=1
# Optional per-route overrides, CLAUDE_MODEL_<ROUTE> and CLAUDE_EFFORT_<ROUTE>, for the routes MANDATE_COMPILE,
# SHOPPING_AGENT, INTENT_CHECK, CATALOG_BUILD, DISPUTE_EVIDENCE and STUDIO_ANALYST, e.g. CLAUDE_EFFORT_INTENT_CHECK=medium.

# --- Optional services ---
# Channel3 product search, for open-web market prices in the shopping agent and listing benchmarks.
CHANNEL3_API_KEY=
# AG Studio licence key for /dashboard.
AG_STUDIO=

# --- Set for you; leave these out ---
# DATABASE_URL: docker-compose.yml points it at the bundled Postgres.
# WORKER: docker-compose.yml sets it to 1, so the app runs the background jobs.
# NODE_ENV: the image sets it to production.
# LLM_STUB: replays recorded Claude replies in development only; never set it here.
