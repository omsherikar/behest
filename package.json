    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "canonicalize": "5.1.0",
    "drizzle-orm": "^0.45.4",
    "jose": "6.2.15",
    "next": "16.3.6",
    "papaparse": "5.7.0",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
